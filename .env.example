# Servidor Backend - Agente Solar
PORT=3001
NODE_ENV=development

# ── Supabase (required for company profiles) ──────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# NASA POWER API
NASA_API_BASE_URL=https://power.larc.nasa.gov/api
NASA_LATITUDE=11.5444
NASA_LONGITUDE=-72.9072
NASA_COMMUNITY=RE

# OpenRouter LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-235b-a22b

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Cache TTL en segundos (1 hora)
CACHE_TTL=3600

# Cloudflare R2 para reportes enviados por WhatsApp
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_ACCOUNT_ID=your_r2_account_id_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-public-bucket-url.r2.dev
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
